# Backend settings
APP_NAME=Microplastic Risk Platform API
APP_ENV=development
APP_DEBUG=true
API_PREFIX=
HOST=0.0.0.0
PORT=8000

# ML settings
YOLO_MODEL_PATH=models/yolov8-microplastic.pt
SAHI_SLICE_HEIGHT=640
SAHI_SLICE_WIDTH=640
SAHI_OVERLAP=0.2

# Climate settings
CLIMATE_DATA_MODE=mock
CLIMATE_API_BASE_URL=https://example-climate-provider.local
CLIMATE_API_KEY=replace_me

# Risk settings
DEFAULT_WATER_TYPE=treated_water
